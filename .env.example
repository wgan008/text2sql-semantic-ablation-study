# GCP
GCP_PROJECT_ID=text2sql-sem-ablation-xxxx
GCP_LOCATION=us-central1
BQ_DATASET=bird_eval
# Hard cap per BigQuery query (bytes). 1 GB = 1000000000
BQ_MAX_BYTES_BILLED=1000000000

# Gemini: set GEMINI_API_KEY to use the Gemini API (AI Studio, free tier available).
# Leave it empty to use Vertex AI through your GCP project and ADC credentials.
GEMINI_API_KEY=
